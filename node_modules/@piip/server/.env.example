# Server configuration
PORT=3000
# Use a strong secret in real environments
JWT_SECRET=dev-secret-change-me

# OpenTelemetry
# Base endpoint (collector): e.g., http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# or traces endpoint only (overrides above if set)
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=piip-server
OTEL_DEBUG=false

# Metrics exposure: all | internal
METRICS_EXPOSE=all
